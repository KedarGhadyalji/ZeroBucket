# Settings for running the test suites against real databases.
# Copy this file to .env and fill in real values. .env is gitignored -- never commit real credentials.
#
# The npm package's tests (packages/typescript) read this file automatically, so there is nothing to `set` or `export`.
# A value here wins over a variable already set in your shell; the test run prints which values it used, with
# passwords hidden. Run `npm run test:env` in packages/typescript to check these settings and try the connections. The Python tests do not read .env yet: set the same variables in your shell for those.
#
# Save this file as UTF-8, and make sure it is called .env (not .env.txt).
#
# A password containing special characters must be URL-encoded in these URLs:
#   @ is %40   : is %3A   / is %2F   # is %23   % is %25

ZEROBUCKET_TEST_DATABASE_URL=postgresql://postgres:YOUR_REAL_PASSWORD@localhost:5432/zerobucket_test

# Optional. The MySQL/MariaDB tests are skipped when this is not set.
ZEROBUCKET_TEST_MYSQL_URL=mysql://zerobucket:YOUR_REAL_MYSQL_PASSWORD@127.0.0.1:3306/zerobucket_test

# Optional. The object-storage (tiering) tests are skipped without it, for example against a local moto server
# (`moto_server -p 5000`).
# ZEROBUCKET_TEST_S3_ENDPOINT=http://localhost:5000
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_DEFAULT_REGION=us-east-1
