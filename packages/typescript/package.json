{
  "name": "zerobucket",
  "version": "0.6.0",
  "description": "Database-native image storage for Node.js. Your database. Your images. Zero buckets.",
  "license": "MIT",
  "author": "Kedar Ghadyalji",
  "homepage": "https://github.com/KedarGhadyalji/ZeroBucket",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KedarGhadyalji/ZeroBucket.git",
    "directory": "packages/typescript"
  },
  "keywords": [
    "images",
    "postgres",
    "postgresql",
    "bytea",
    "storage",
    "database",
    "uploads",
    "nextjs",
    "express",
    "s3",
    "object-storage",
    "tiering",
    "dedup",
    "deduplication",
    "sqlite",
    "better-sqlite3",
    "cli",
    "heic",
    "heif",
    "iphone"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/http.d.ts",
        "default": "./dist/http.js"
      },
      "require": {
        "types": "./dist/http.d.cts",
        "default": "./dist/http.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "zerobucket": "./dist/bin.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3.500.0",
    "better-sqlite3": ">=9.0.0",
    "pg": ">=8.11.0",
    "sharp": ">=0.33.0",
    "libheif-js": ">=1.17.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "libheif-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "better-sqlite3": "^13.0.3",
    "libheif-js": "^1.23.5",
    "pg": "^8.13.0",
    "sharp": "^0.33.5",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
